# URL of the FastAPI backend.
# Local dev: http://localhost:8000
# Production (HF Spaces): https://<your-user>-<space-name>.hf.space
API_URL=http://localhost:8000

# HuggingFace token (only needed if you want the frontend to call HF APIs
# directly - otherwise leave unset). Generate at:
# https://huggingface.co/settings/tokens
# DO NOT commit a real token here. Put it in .env.local (gitignored).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxx
